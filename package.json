{
  "name": "shoal",
  "private": true,
  "version": "1.0.0",
  "description": "Shoal — shelf-sea end-to-end ecosystem modelling workbench (GOTM + FABM + ERSEM/ECOSMO/ERGOM + MIZER/E2E) with visualization",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "kernel": "node scripts/venv.mjs kernel/build.py",
    "check:env": "node scripts/venv.mjs scripts/check_env.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
